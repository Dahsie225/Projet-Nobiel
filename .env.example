# ============================================================
# Copie ce fichier en .env et remplis les valeurs
# cp .env.example .env
# ============================================================

# Flask
FLASK_ENV=production
FLASK_APP=run.py
FLASK_SECRET=change_this_to_a_very_strong_secret_key_32chars
DEBUG=False

# Base de données (DB_HOST=db quand Docker Compose, 127.0.0.1 en local)
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_root_password
DB_NAME=team_nobiel

# Email (Gmail exemple)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=noreply@nobiel.ci

# CinetPay (paiement)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

